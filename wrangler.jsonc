// Cloudflare settings for the BeanByte Studio website.
// The site is plain files in public/, served by a Worker with no code of its own.
{
  "name": "beanbytestudio-site", // must match the Worker name in the Cloudflare dashboard
  "workers_dev": true,           // turn on the free beanbytestudio-site.beanbytes.workers.dev address
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash", // /about serves about.html
    "not_found_handling": "404-page"        // unknown paths show 404.html
  }
}
